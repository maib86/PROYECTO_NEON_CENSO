# Copiar a .env y completar. .env está en .gitignore y nunca se sube.
# Host SIN "-pooler". sslmode=require siempre.

# Rol propietario (administración, migraciones)
DATABASE_URL=postgresql://neondb_owner:CLAVE@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Rol de solo lectura (tablero)
DATABASE_URL_TABLERO=postgresql://tablero_lectura:CLAVE@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

# Roles de edición (solo para pruebas de RLS desde psql; QGIS los tiene guardados aparte)
DATABASE_URL_LOTE_A=postgresql://edit_lote_a:CLAVE@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_LOTE_B=postgresql://edit_lote_b:CLAVE@ep-xxxx.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require

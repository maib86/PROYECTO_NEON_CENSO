# Copiar a .env y completar. .env está en .gitignore y nunca se sube.
# Host SIN "-pooler". sslmode=require siempre.
# URL entre comillas simples: así el shell no la corta si trae & (p. ej. &channel_binding=require)
# o $, al cargar con: set -a; . ./.env; set +a

# Rol propietario (administración, migraciones)
DATABASE_URL='postgresql://neondb_owner:CLAVE@HOST/neondb?sslmode=require'

# Rol de solo lectura (tablero)
DATABASE_URL_TABLERO='postgresql://tablero_lectura:CLAVE@HOST/neondb?sslmode=require'

# Roles de edición (solo para pruebas de RLS desde psql; QGIS los tiene guardados aparte)
DATABASE_URL_LOTE_A='postgresql://edit_lote_a:CLAVE@HOST/neondb?sslmode=require'
DATABASE_URL_LOTE_B='postgresql://edit_lote_b:CLAVE@HOST/neondb?sslmode=require'

# Credenciales — NUNCA se suben
.env
*.env
credenciales*

# Salidas generadas
tablero/salida/
public/
*.dump
*.backup
*.bundle

# Locales
.claude/settings.local.json
__pycache__/
*.pyc
.DS_Store
Thumbs.db

# Capas de trabajo locales (p. ej. datos_prueba/ugm/ugm.gpkg, capa UGM del SNIT, 206 MB)
*.gpkg

# Proyectos QGIS: contienen el host y QGIS puede guardar la clave en texto plano (D-17)
*.qgz
*.qgs
# Excepción (D-17, D-19): proyectos de campo con conexión solo por pg_service, sin host ni clave
!campo/*.qgs
# Subproductos que QGIS escribe junto al .qgs
campo/*.qgs~
campo/*_attachments.zip
campo/*.qgd
# Archivos de servicio libpq: contienen la clave (docs/guia/pg_service.md)
*pg_service.conf

# Salidas de la simulación S04 (paquetes, temporales)
sim/salida/

# Paquete para el celular (D-22): contiene pg_service.conf con la clave del rol. Nunca se sube.
campo/paquete_movil/

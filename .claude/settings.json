{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(py tablero/*)",
      "Bash(py -m pip *)",
      "Bash(py -m playwright *)",
      "Bash(psql --version)",
      "Bash(ls *)",
      "Bash(dir *)"
    ],
    "ask": [
      "Bash(psql *)",
      "Bash(git push *)",
      "Bash(gh *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)"
    ]
  }
}

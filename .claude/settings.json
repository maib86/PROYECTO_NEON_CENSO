{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(py tablero/generar_tablero.py *)",
      "Bash(py tablero/capturar_tablero.py *)",
      "Bash(py sim/*)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(ogrinfo *)",
      "Bash(ogr2ogr *)",
      "Bash(\"/c/Program Files/QGIS 3.34.11/bin/ogrinfo.exe\" *)",
      "Bash(\"/c/Program Files/QGIS 3.34.11/bin/ogr2ogr.exe\" *)",
      "Bash(py tablero/construir_fixture_demo.py *)",
      "Bash(py -m pip *)",
      "Bash(py -m playwright *)",
      "Bash(psql --version)",
      "Bash(ls *)",
      "Bash(dir *)"
    ],
    "ask": [
      "Bash(gh *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)"
    ]
  }
}
